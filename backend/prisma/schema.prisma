generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserRole {
  USER
  ADMIN
  VENDOR
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  INITIALIZED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CREDIT_CARD
  CASH_ON_DELIVERY
  WORKFORCE_WALLET
}

// --- AUTH MODELS ---

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?   
  password      String?   
  phone         String?   @unique // Kept as 'phone' per your request
  country       String?
  
  role          UserRole  @default(USER)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  vendor    Vendor?   
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  payments      Payment[] 
  // ADD THESE FIELDS:
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  
  members       Member[]      
  invitations   Invitation[]  

  @@map("user")
}

model Vendor {
  id          String    @id @default(cuid())
  storeName   String    @unique
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]

  @@map("vendor")
}

// --- STORE MODELS ---

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  image    String
  products Product[]

  @@map("category")
}

model Product {
  id          String      @id @default(cuid())
  title       String
  price       Float
  description String
  images      String[]    
  
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String      
  
  orderItems  OrderItem[] 
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])

  @@map("product")
}

// --- BETTER-AUTH REQUIRED MODELS ---

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  activeOrganizationId String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  provider              String?
  type                  String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Organization {
  id          String   @id
  name        String
  slug        String?  @unique
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

model Member {
  id             String   @id
  role           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}


// --- TRANSACTIONAL MODELS ---

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique 
  
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  
  items           OrderItem[]
  
  totalAmount     Float
  taxAmount       Float          @default(0)
  shippingFees    Float          @default(0)
  
  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(INITIALIZED)
  paymentMethod   PaymentMethod
  
  shippingAddress String
  phoneNumber     String         // Used for delivery contact
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  payment         Payment?

  @@map("order")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String   
  product         Product  @relation(fields: [productId], references: [id])
  
  quantity        Int
  priceAtPurchase Float

  @@map("order_item")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id])
  
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  
  transactionRef String        @unique 
  amount         Float
  status         PaymentStatus @default(INITIALIZED)
  provider       String        
  
  createdAt      DateTime      @default(now())

  @@map("payment")
}